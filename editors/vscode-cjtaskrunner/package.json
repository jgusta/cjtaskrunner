{
  "name": "cjtaskrunner-vscode",
  "displayName": "CJTaskrunner Tasks",
  "description": "Taskfile language support and task runner view for CJTaskrunner.",
  "version": "0.0.1",
  "publisher": "cjtaskrunner",
  "private": false,
  "license": "MIT",
  "author": {
    "name": "jgusta",
    "url": "https://github.com/jgusta"
  },
  "homepage": "https://github.com/jgusta/cjtaskrunner/tree/main/editors/vscode-cjtaskrunner",
  "repository": {
    "type": "git",
    "url": "https://github.com/jgusta/cjtaskrunner.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:cjtasks",
    "onView:cjtaskrunner.tasks",
    "onCommand:cjtaskrunner.refreshTasks",
    "onCommand:cjtaskrunner.runTask",
    "workspaceContains:cjtasks",
    "workspaceContains:*.cjtasks"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "cjtasks",
        "aliases": [
          "cjtasks",
          "CJTaskrunner"
        ],
        "filenames": [
          "cjtasks"
        ],
        "extensions": [
          ".cjtasks"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cjtasks",
        "scopeName": "source.cjtasks",
        "path": "./syntaxes/cjtasks.tmLanguage.json"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "cjtaskrunner.tasks",
          "name": "CJTaskrunner"
        }
      ]
    },
    "commands": [
      {
        "command": "cjtaskrunner.refreshTasks",
        "title": "Refresh Tasks",
        "icon": "$(refresh)"
      },
      {
        "command": "cjtaskrunner.runTask",
        "title": "Run Task",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "cjtaskrunner.refreshTasks",
          "when": "view == cjtaskrunner.tasks",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "cjtaskrunner.runTask",
          "when": "view == cjtaskrunner.tasks && viewItem == cjtaskrunner.task",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "CJTaskrunner",
      "properties": {
        "cjtaskrunner.executable.path": {
          "type": "string",
          "default": "",
          "description": "Path to cj or cjtaskrunner. Empty uses bundled binary, then workspace target/debug, then PATH."
        },
        "cjtaskrunner.lsp.path": {
          "type": "string",
          "default": "",
          "description": "Path to cjtaskrunner-lsp. Empty uses bundled binary, then workspace target/debug, then PATH."
        },
        "cjtaskrunner.lsp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace communication with the CJTaskrunner language server."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "npx @vscode/vsce package",
    "publish:vsce": "npx @vscode/vsce publish",
    "package:ci": "npm run compile && vsce package --no-dependencies",
    "publish:dry-run": "vsce package --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.5",
    "@vscode/vsce": "^3.9.1"
  },
  "bugs": {
    "url": "https://github.com/jgusta/cjtaskrunner/issues"
  },
  "keywords": [
    "cjtasks",
    "task-runner",
    "build-tool",
    "language-support"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#111827",
    "theme": "dark"
  },
  "preview": false,
  "qna": "https://github.com/jgusta/cjtaskrunner/discussions",
  "badges": [
    {
      "url": "https://img.shields.io/badge/cjtaskrunner-vscode-6366f1",
      "href": "https://github.com/jgusta/cjtaskrunner/tree/main/editors/vscode-cjtaskrunner",
      "description": "Project home"
    }
  ]
}
